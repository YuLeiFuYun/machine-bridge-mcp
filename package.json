{
  "name": "machine-bridge-mcp",
  "version": "0.16.1",
  "description": "Cross-client MCP bridge for local agent context, structured browser and application automation, files, Git, processes, resources, and durable jobs over stdio or OAuth relay.",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=26.0.0",
    "npm": ">=12.0.0"
  },
  "bin": {
    "machine-bridge-mcp": "bin/machine-mcp.mjs",
    "machine-mcp": "bin/machine-mcp.mjs",
    "mbm": "bin/machine-mcp.mjs"
  },
  "files": [
    "mbm",
    "mbm.cmd",
    "bin",
    "browser-extension",
    "src/local",
    "src/shared",
    "src/worker/index.ts",
    "scripts",
    "wrangler.jsonc",
    "tsconfig.json",
    "README.md",
    "SECURITY.md",
    "CHANGELOG.md",
    "CONTRIBUTING.md",
    "docs",
    "LICENSE"
  ],
  "scripts": {
    "start": "node bin/machine-mcp.mjs start",
    "doctor": "node bin/machine-mcp.mjs doctor",
    "self-test": "node tests/local-self-test.mjs",
    "version:sync": "node scripts/sync-worker-version.mjs",
    "version:check": "node scripts/sync-worker-version.mjs --check",
    "version": "node scripts/sync-worker-version.mjs && git add package.json package-lock.json src/worker/index.ts browser-extension/manifest.json",
    "prepack": "npm run version:check && npm run privacy:check && npm run release-impact:check",
    "prepublishOnly": "npm run check && npm run version:check && npm run release:check",
    "worker:types": "wrangler types src/worker/worker-configuration.d.ts",
    "typecheck": "npm run worker:types && tsc -p tsconfig.json --noEmit",
    "syntax": "node scripts/syntax-check.mjs",
    "check": "npm run privacy:check && npm run privacy:test && npm run release-impact:check && npm run release-impact:test && npm run release-state:test && npm run release-ci:test && npm run network-retry:test && npm run relay:test && npm run secure-file:test && npm run architecture:test && npm run policy:test && npm run policy-docs:check && npm run runtime-infrastructure:test && npm run runtime-handlers:test && npm run cli-entrypoint:test && npm run lifecycle:test && npm run logging-structure:test && npm run coverage:test && npm run worker-runtime-infrastructure:test && npm run typecheck && npm run syntax && npm run process-lock:test && npm run service-lifecycle:test && npm run service-platform:test && npm run catalog:test && npm run agent-context:test && npm run capability-ranking:test && npm run browser-command:test && npm run browser-devtools-input:test && npm run browser-service-worker:test && npm run browser-page-automation:test && npm run browser-bridge:test && npm run app-automation:test && npm run self-test && npm run atomic-fs:test && npm run package:test && npm run ssh-key:test && npm run full-access:test && npm run managed-jobs:test && npm run stdio:integration-test && npm run worker:integration-test",
    "worker:dry-run": "wrangler deploy --dry-run",
    "worker:integration-test": "node tests/worker-integration-test.mjs",
    "release:check": "node scripts/github-release.mjs --check",
    "release:publish": "node scripts/github-release.mjs --publish",
    "release:backfill": "node scripts/github-release.mjs --backfill",
    "stdio:integration-test": "node tests/stdio-integration-test.mjs",
    "catalog:test": "node tests/catalog-test.mjs",
    "managed-jobs:test": "node tests/managed-jobs-test.mjs",
    "ssh-key:test": "node tests/ssh-key-test.mjs",
    "full-access:test": "node tests/full-access-test.mjs",
    "atomic-fs:test": "node tests/atomic-fs-test.mjs",
    "privacy:check": "node scripts/privacy-check.mjs",
    "privacy:history": "node scripts/privacy-check.mjs --history",
    "package:test": "node tests/package-test.mjs",
    "release-impact:check": "node scripts/release-impact-check.mjs",
    "release-impact:test": "node tests/release-impact-test.mjs",
    "privacy:test": "node tests/privacy-test.mjs",
    "network-retry:test": "node tests/network-retry-test.mjs",
    "relay:test": "node tests/relay-connection-test.mjs",
    "install:test": "node tests/install-smoke-test.mjs",
    "secure-file:test": "node tests/secure-file-test.mjs",
    "architecture:test": "node tests/architecture-test.mjs",
    "release-state:test": "node tests/release-state-test.mjs",
    "release-ci:test": "node tests/release-ci-test.mjs",
    "agent-context:test": "node tests/agent-context-test.mjs",
    "browser-bridge:test": "node tests/browser-bridge-test.mjs",
    "app-automation:test": "node tests/app-automation-test.mjs",
    "process-lock:test": "node tests/process-lock-test.mjs",
    "service-lifecycle:test": "node tests/service-lifecycle-test.mjs",
    "app-automation:live-test": "node tests/app-automation-test.mjs --live-macos",
    "browser-command:test": "node tests/browser-command-test.mjs",
    "browser-devtools-input:test": "node tests/browser-devtools-input-test.mjs",
    "browser-page-automation:test": "node tests/browser-page-automation-test.mjs",
    "browser-service-worker:test": "node tests/browser-service-worker-test.mjs",
    "service-platform:test": "node tests/service-platform-test.mjs",
    "policy:test": "node tests/policy-test.mjs",
    "runtime-infrastructure:test": "node tests/runtime-infrastructure-test.mjs",
    "worker-runtime-infrastructure:test": "node tests/worker-runtime-infrastructure-test.mjs",
    "logging-structure:test": "node tests/logging-structure-test.mjs",
    "policy-docs:generate": "node scripts/generate-policy-reference.mjs",
    "policy-docs:check": "node scripts/generate-policy-reference.mjs --check",
    "coverage:test": "node scripts/coverage-check.mjs",
    "capability-ranking:test": "node tests/capability-ranking-test.mjs",
    "lifecycle:test": "node tests/lifecycle-test.mjs",
    "runtime-handlers:test": "node tests/runtime-handler-matrix-test.mjs",
    "cli-entrypoint:test": "node tests/cli-entrypoint-test.mjs"
  },
  "dependencies": {
    "https-proxy-agent": "9.1.0",
    "proxy-from-env": "2.1.0",
    "wrangler": "4.110.0",
    "ws": "8.21.0"
  },
  "devDependencies": {
    "@types/node": "26.1.1",
    "typescript": "7.0.2"
  },
  "keywords": [
    "mcp",
    "remote-mcp",
    "cloudflare-workers",
    "durable-objects",
    "wrangler",
    "local-machine",
    "stdio",
    "coding-agent",
    "oauth",
    "cross-platform",
    "ssh",
    "automation",
    "managed-jobs",
    "browser-automation",
    "desktop-automation",
    "agent-skills"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/YuLeiFuYun/machine-bridge-mcp.git"
  },
  "bugs": {
    "url": "https://github.com/YuLeiFuYun/machine-bridge-mcp/issues"
  },
  "homepage": "https://github.com/YuLeiFuYun/machine-bridge-mcp#readme",
  "allowScripts": {
    "esbuild@0.28.1": true,
    "sharp@0.34.5": true,
    "workerd@1.20260708.1": true,
    "fsevents": false
  },
  "packageManager": "npm@12.0.1",
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": ">=26.0.0",
      "onFail": "error"
    },
    "packageManager": {
      "name": "npm",
      "version": ">=12.0.0",
      "onFail": "error"
    }
  }
}
